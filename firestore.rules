rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function currentEmail() {
      return signedIn()
        ? request.auth.token.email
        : null;
    }

    function isAdmin() {
      return signedIn()
        && exists(
          /databases/$(database)/documents/admins/$(currentEmail())
        );
    }

    // =========================
    // PRODUCTS
    // =========================

    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // =========================
    // GAMES
    // =========================

    match /games/{gameId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // =========================
    // CATEGORIES
    // =========================

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // =========================
    // USERS
    // =========================

    match /users/{userId} {
      allow read: if isAdmin()
        || (
          signedIn()
          && request.auth.uid == userId
        );

      allow create: if signedIn()
        && request.auth.uid == userId;

      allow update: if isAdmin()
        || (
          signedIn()
          && request.auth.uid == userId
        );

      allow delete: if isAdmin();
    }

    // =========================
    // ORDERS
    // =========================

    match /orders/{orderId} {
      allow read: if isAdmin()
        || (
          signedIn()
          && resource.data.email == currentEmail()
        );

      allow create: if signedIn()
        && request.resource.data.email == currentEmail();

      allow update: if isAdmin();

      allow delete: if isAdmin();
    }

    // =========================
    // PAYMENTS
    // =========================

    match /payments/{paymentId} {
      allow read: if isAdmin()
        || (
          signedIn()
          && resource.data.email == currentEmail()
        );

      allow create: if signedIn()
        && request.resource.data.email == currentEmail();

      allow update: if isAdmin();

      allow delete: if isAdmin();
    }

    // =========================
    // VIP MEMBERS
    // =========================

    match /vipMembers/{email} {
      allow read: if isAdmin()
        || (
          signedIn()
          && currentEmail() == email
        );

      allow write: if isAdmin();
    }

    // =========================
    // VIP PAYMENTS
    // =========================

    match /vipPayments/{paymentId} {
      allow read: if isAdmin()
        || (
          signedIn()
          && resource.data.email == currentEmail()
        );

      allow create: if signedIn()
        && request.resource.data.email == currentEmail();

      allow update: if isAdmin();

      allow delete: if isAdmin();
    }

    // =========================
    // ADMINS
    // =========================

    match /admins/{adminEmail} {
      allow read: if isAdmin()
        || (
          signedIn()
          && currentEmail() == adminEmail
        );

      allow write: if isAdmin();
    }

    // =========================
    // ACCOUNT STOCK (V3)
    // =========================

    match /accountStock/{accountId} {
      allow read: if isAdmin()
        || (signedIn()
          && resource.data.status == "sold"
          && resource.data.soldTo == request.auth.uid);
      allow create, update, delete: if isAdmin();
    }

    // =========================
    // SETTINGS
    // =========================

    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}